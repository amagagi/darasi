# ─────────────────────────────────────────────────────────────────────────────
# Copier ce fichier en `.env` puis renseigner les valeurs réelles.
# Aucune valeur ci-dessous n'est un secret valide — ce sont des exemples.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ Application ═══════════════════════════════════════════════════════════
# Nom affiché de l'application (titre mails, panel admin...).
APP_NAME=DARASI
# local | production. Change le comportement de plusieurs packages (Filament,
# error pages...).
APP_ENV=local
# true en local pour voir les erreurs détaillées, false en production.
APP_DEBUG=true
# URL publique de l'application (utilisée pour générer des liens absolus).
APP_URL=http://localhost:8000
# Clé de chiffrement de l'application. OBLIGATOIRE. Ne jamais réutiliser une
# clé d'un autre environnement. Générer avec : php artisan key:generate
APP_KEY=
# Anciennes clés APP_KEY séparées par des virgules, utilisées pour déchiffrer
# les données existantes après une rotation de APP_KEY. Optionnel.
APP_PREVIOUS_KEYS=
# Nombre de rounds bcrypt pour le hachage des mots de passe.
BCRYPT_ROUNDS=12
# file | database. Pilote utilisé par `php artisan down`/`up`.
APP_MAINTENANCE_DRIVER=file

# ═══ Localisation ═══════════════════════════════════════════════════════════
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
# Locale utilisée par Faker dans les seeders/factories.
APP_FAKER_LOCALE=fr_FR

# ═══ Logs ═══════════════════════════════════════════════════════════════════
# Canal de log principal (stack agrège plusieurs canaux, voir LOG_STACK).
LOG_CHANNEL=stack
# Canal(aux) agrégé(s) par le canal "stack" ci-dessus, séparés par des virgules.
LOG_STACK=single
# Canal utilisé pour logger les dépréciations PHP/Laravel (null = ignorées).
LOG_DEPRECATIONS_CHANNEL=null
# debug en local, warning/error en production pour réduire le volume de logs.
LOG_LEVEL=debug
# Nombre de jours de conservation des fichiers pour le canal "daily".
LOG_DAILY_DAYS=14

# ═══ Base de données (MySQL) ════════════════════════════════════════════════
DB_CONNECTION=mysql
# `db` comme host quand ce service tourne dans docker-compose, 127.0.0.1 en
# exécution locale directe.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=darasi
DB_USERNAME=darasi_user
# OBLIGATOIRE en dehors d'un environnement jetable.
DB_PASSWORD=changeme
# Chemin vers un certificat CA pour une connexion MySQL chiffrée. Optionnel.
MYSQL_ATTR_SSL_CA=

# ═══ Authentification & Sanctum ═════════════════════════════════════════════
# Garde d'authentification par défaut.
AUTH_GUARD=web
# Broker utilisé pour la réinitialisation de mot de passe.
AUTH_PASSWORD_BROKER=users
# Délai (secondes) avant expiration d'une demande de réinitialisation.
AUTH_PASSWORD_TIMEOUT=10800
# Domaines autorisés à s'authentifier auprès de l'API via Sanctum en mode
# "stateful" (cookies de session), séparés par des virgules. Nécessaire si le
# frontend appelle l'API depuis un domaine différent avec des cookies.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
# Préfixe optionnel ajouté aux tokens Sanctum générés (aide à les identifier).
SANCTUM_TOKEN_PREFIX=

# ═══ Session ═════════════════════════════════════════════════════════════════
# database est le pilote utilisé en production (voir SESSION_TABLE).
SESSION_DRIVER=database
# Durée de vie de la session en minutes.
SESSION_LIFETIME=120
# Si true, la session expire à la fermeture du navigateur (ignore LIFETIME).
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
# Domaine du cookie de session. Laisser vide (host-only) sauf besoin de
# partager la session entre sous-domaines.
SESSION_DOMAIN=
# true en production derrière HTTPS : le cookie de session n'est alors envoyé
# que sur des requêtes chiffrées.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
# lax | strict | none. "lax" est le bon compromis par défaut.
SESSION_SAME_SITE=lax

# ═══ Cache & Files d'attente ═════════════════════════════════════════════════
# database est le pilote actif de ce déploiement (voir alternatives plus bas).
CACHE_STORE=database
QUEUE_CONNECTION=database

# ═══ Mail (SMTP) ═════════════════════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=contact@example.com
MAIL_PASSWORD=changeme
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="DARASI"

# ═══ Komipay (paiement mobile money) ════════════════════════════════════════
# Identifiants fournis par Komipay — jamais les identifiants de production
# dans ce fichier d'exemple.
KOMIPAY_BASE_URL=https://www.komipay.com/APIs/mobile_money.php/customers-api-kp/v1
KOMIPAY_TOKEN_URL=https://www.komipay.com/APIs/mobile_money.php/generateToken
KOMIPAY_LOGIN=your-komipay-login@example.com
KOMIPAY_PASSWORD=changeme
KOMIPAY_API_KEY=your-komipay-api-key-here
KOMIPAY_KEYPASS=changeme
# Délai (secondes) avant timeout des appels à l'API Komipay.
KOMIPAY_TIMEOUT=120

# ═══ reCAPTCHA v3 ════════════════════════════════════════════════════════════
# Clés obtenues sur https://www.google.com/recaptcha/admin (type « v3 »).
# La site key est publique, la secret key ne doit jamais être exposée côté
# client. Les deux vides = vérification désactivée de bout en bout.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ═══ Stockage / uploads ══════════════════════════════════════════════════════
# local sert les fichiers via `storage:link` (voir docker-entrypoint.sh).
FILESYSTEM_DISK=local
# Note : les limites de taille d'upload (actuellement 5 Mo pour les images
# d'Actualités) sont fixées au niveau de PHP (conf.d/uploads.ini dans l'image
# Docker) et nginx (client_max_body_size), pas via des variables d'env ici —
# les anciennes UPLOAD_MAX_FILESIZE/POST_MAX_SIZE/MEMORY_LIMIT de ce fichier
# n'avaient aucun effet réel et ont été retirées.

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONNEL — pilotes alternatifs non utilisés par ce déploiement.
# Ces variables sont bien lues par le code (Redis/Memcached/S3/SQS/Postmark/
# Resend/Slack/Beanstalkd) mais inertes tant que CACHE_STORE/QUEUE_CONNECTION/
# FILESYSTEM_DISK ci-dessus valent database/database/local. Décommenter et
# renseigner uniquement si vous changez l'un de ces pilotes.
# ─────────────────────────────────────────────────────────────────────────────

# --- Redis (cache/queue/cache applicatif) ---
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

# --- Memcached (alternative de cache) ---
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211

# --- AWS S3 (alternative de stockage FILESYSTEM_DISK=s3) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- AWS SQS (alternative de queue) ---
# SQS_PREFIX=
# SQS_QUEUE=default

# --- Mail via API (alternatives à SMTP) ---
# POSTMARK_API_KEY=
# RESEND_API_KEY=

# --- Notifications Slack (canal de log) ---
# LOG_SLACK_WEBHOOK_URL=
